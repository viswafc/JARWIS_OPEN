# JARWIS — Environment Configuration
# ===================================================================
# Copy this file to .env.local (happens automatically on npm start).
# All values below have sensible defaults for running out-of-the-box.

# ===================================================================
# FRONTEND CONFIGURATION (Vite)
# ===================================================================

# Intelligence backend ('bridge' connects to local Node bridge server)
VITE_BACKEND=bridge
VITE_BRIDGE_URL=ws://localhost:8787

# Voice synthesis engine ('kokoro' runs 100% locally via WebGPU/ONNX; 'system' uses browser SpeechSynthesis)
VITE_TTS_ENGINE=kokoro

# Kokoro neural voice selection (British male: bm_george | bm_fable | bm_lewis | bm_daniel)
VITE_KOKORO_VOICE=bm_george

# Set to true only if you have an ElevenLabs API key and want cloud voice
VITE_USE_ELEVENLABS=false


# ===================================================================
# BRIDGE CONFIGURATION (Node.js Intelligence Engine)
# ===================================================================

# Port the bridge WebSocket listens on (default: 8787)
JARVIS_BRIDGE_PORT=8787

# Interface the bridge binds to (default: 127.0.0.1 loopback only)
JARVIS_BRIDGE_HOST=127.0.0.1

# AI Reasoning Model for Antigravity engine (gemini-3.8-flash-medium | gemini-3.8-flash-high)
JARVIS_MODEL=gemini-3.8-flash-medium

# Allow write actions (terminal commands, file writes, UI state changes)
# 1 = Full autonomy, 0 = Read-only mode
JARVIS_ALLOW_WRITES=1

# Optional: Path to Antigravity CLI executable (auto-detected by default)
# ANTIGRAVITY_AGENTAPI_EXE=C:\Users\<username>\.gemini\bin\agy.exe
